# Version control
.git/
.gitignore

# Build outputs
build/
*/build/
**/build/
out/
target/

# Gradle caches (local, not what's in the container)
.gradle/
**/.gradle/
.gradle-codex/

# Node / frontend
node_modules/
**/node_modules/
.npm/
.yarn/

# Local Python / tool caches
.uv-cache/
.uv-cache-codex/
.uv-python/
.uv-python-codex/
engine/.pytest-tmp/
engine/.ruff_cache/
engine/.venv/
engine/pytest-cache-files-*/
engine/tmp*/

# IDE and editor
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Logs and temp files
*.log
*.tmp
*.pid
.DS_Store
Thumbs.db

# Docker itself
Dockerfile*
.dockerignore

# CI / CD configs (not needed in build context)
.github/
.circleci/
.gitlab-ci.yml

# Test reports
**/test-results/
**/jacoco/

# Local env
.env
.env.*
!.env.example
